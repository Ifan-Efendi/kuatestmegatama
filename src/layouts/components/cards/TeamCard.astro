---
import type { CollectionEntry } from "astro:content";
import { markdownify, toSentenceCase } from "@/lib/utils/textConverter";
import { getLocaleUrlCTM, useTranslations } from "@/lib/utils/i18nUtils.ts";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import Icons from "@/helpers/Icons.astro";
import extractSlug from "@/lib/utils/extractSlug";

interface Props {
  content: CollectionEntry<"team">;
  class?: string;
}

const { content, class: className, ...rest } = Astro.props;
const { title, image, profession, categories } = content.data;

const t = await useTranslations(Astro.currentLocale as string);
const slug = getLocaleUrlCTM(
  extractSlug(content),
  Astro.currentLocale,
  content.collection,
);
const categoryLabel = categories?.[0];
---

<article
  data-cursor-label={t("common.viewDetails")}
  data-cursor-type="link"
  data-product-categories={categories?.join(",") || ""}
  class:list={[
    "product-team-card group relative flex h-full flex-col overflow-hidden rounded-2xl border border-border-light bg-white shadow-card transition duration-300 hover:shadow-card-hover",
    className,
  ]}
  {...rest}>
  <div class="team-card-image-bg aspect-team-card-image relative overflow-hidden rounded-t-2xl">
    {categoryLabel && (
      <span class="bg-theme-dark absolute top-3 left-3 z-10 rounded-full px-3 py-1 text-xs font-semibold text-white">
        {categoryLabel}
      </span>
    )}
    {
      image && (
        <OptimizedImage
          src={image}
          alt={title}
          class="pointer-events-none h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-4 sm:px-6 sm:pt-5 sm:pb-6">
    {title && (
      <h3
        class="text-base leading-snug font-semibold sm:text-lg"
        data-product-title
        set:html={markdownify(title)}
      />
    )}
    {profession && (
      <p
        class="text-text-default mt-2 text-sm leading-6"
        set:html={markdownify(profession)}
      />
    )}
    <a
      href={slug}
      title={toSentenceCase(t("common.learnMoreAbout") + " " + title)}
      class="border-border-light text-dark hover:border-theme-dark hover:bg-theme-dark hover:text-white relative z-20 mt-auto inline-flex items-center justify-center gap-2 rounded-full border px-4 py-2.5 text-sm font-semibold transition duration-300 sm:mt-5">
      <span set:html={t("common.readMore")} />
      <Icons icon="ArrowRight" class="size-4" />
    </a>
  </div>
</article>

<style>
  .team-card-image-bg {
    background:
      radial-gradient(
        circle at 80% 12%,
        color-mix(in srgb, var(--color-primary) 14%, transparent),
        transparent 34%
      ),
      radial-gradient(
        circle at 12% 88%,
        color-mix(in srgb, var(--color-primary) 9%, transparent),
        transparent 30%
      ),
      linear-gradient(145deg, #fbfcff 0%, #eef2fb 48%, #e2e8f7 100%);
  }

  .team-card-image-bg::before {
    content: "";
    position: absolute;
    inset: 22px 22px 0;
    border-radius: 20px 20px 0 0;
    background: color-mix(in srgb, white 78%, transparent);
    box-shadow: 0 18px 40px -18px color-mix(in srgb, var(--color-dark) 28%, transparent);
  }

  .team-card-image-bg img {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .team-card-image-bg::before {
      inset: 12px 12px 0;
      border-radius: 16px 16px 0 0;
    }
  }
</style>

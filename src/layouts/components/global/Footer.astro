---
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils.ts";
import { markdownify } from "@/lib/utils/textConverter";
import { splitProtectedText } from "@/lib/utils/splitProtectedText";
import SocialComponent from "@/components/widgets/Social.astro";
import social from "@/config/social.json";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";
import Logo from "@/components/global/Logo.astro";
import { getFooterMenuGroups } from "@/lib/utils/menu";

const { footerSpaceTop = false, hasFooterDarkBackground = false } = Astro.props;

import config from ".astro/config.generated.json";
const t = await useTranslations(Astro.currentLocale as string);

let {
  copyright,
  footerDescription,
  contactInfo: { phone, phone2, email },
} = config.settings;

footerDescription = footerDescription || t("footer.description") || "";
const footerColumns = getFooterMenuGroups(t);

const copyrightText = splitProtectedText(
  copyright.text || t("footer.copyright") || "",
).join(" / ");

const socialOrder = ["tiktok", "instagram", "facebook", "youtube"];
const getSocialSortIndex = (label: string) => {
  const index = socialOrder.indexOf(label);

  return index === -1 ? socialOrder.length : index;
};

const footerSocials = social.main
  .filter((item) => item.enable)
  .sort(
    (first, second) =>
      getSocialSortIndex(first.label) - getSocialSortIndex(second.label),
  );
---

<footer
  class:list={[
    "py-0!",
    hasFooterDarkBackground ? "footer-dark" : "bg-theme-light",
    footerSpaceTop && "mt-16 lg:mt-20 xl:mt-24",
  ]}>
  <div class="container">
    <div class="section-spacing-top">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-8">
        <div class="lg:col-span-4">
          <Logo class="gap-1.5" />
          {
            footerDescription && (
              <p
                class="footer-description leading-body text-text-default mt-6 max-w-md text-base"
                set:html={markdownify(footerDescription)}
              />
            )
          }
          <div class="mt-4 flex flex-col gap-3">
            <div class="flex items-center gap-2 hover:underline">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span set:html={markdownify(phone)} />
            </div>

            <div class="flex items-center gap-2 hover:underline">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="currentColor"
                xmlns="http://www.w3.org/2000/svg">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span set:html={markdownify(phone2)} />
            </div>

            <div class="flex items-center gap-2 hover:underline">
              <svg
                width="20"
                height="20"
                viewBox="0 0 20 20"
                fill="none"
                xmlns="http://www.w3.org/2000/svg">
                <path
                  d="M1.66675 16.6667V3.33333H18.3334V16.6667H1.66675ZM10.0001 10.8333L16.6667 6.66666V4.99999L10.0001 9.16666L3.33341 4.99999V6.66666L10.0001 10.8333Z"
                  fill="currentColor">
                </path>
              </svg>
              <span set:html={markdownify(email)} />
            </div>
          </div>

          <SocialComponent
            size="md"
            buttonSize="md"
            class="footer-social mt-10 gap-2"
            linkType="follow"
            list={footerSocials}
          />
        </div>

        <nav
          aria-label={t("aria.footer")}
          class="grid gap-y-10 sm:grid-cols-2 sm:gap-x-10 md:sm:grid-cols-3 lg:col-span-7 lg:col-start-6 lg:gap-x-12 xl:gap-x-16">
          {
            footerColumns.map(({ label, list }) => (
              <div>
                {label && (
                  <h2 class="footer-heading text-xl" set:html={label} />
                )}
                <ul class="mt-5 flex flex-col gap-2.5">
                  {list.map((item) => (
                    <li>
                      {item.url ? (
                        <a
                          class:list={[
                            "footer-link leading-body text-text-default hover:text-dark text-base transition duration-300 break-words",
                            item.active && "active text-dark",
                          ]}
                          href={getLocaleUrlCTM(item.url, Astro.currentLocale)}
                          set:html={item.name}
                        />
                      ) : (
                        <span class="footer-link leading-body text-text-default text-base break-words" set:html={item.name} />
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>
    </div>
    <div class="footer-bottom py-4 text-center">
      {
        config.settings.copyright?.enable && (
          <p
            class="footer-copyright text-text-default text-sm"
            set:html={markdownify(copyrightText)}
          />
        )
      }
    </div>
  </div>
</footer>

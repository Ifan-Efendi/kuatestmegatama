---
import ProductSearch from "./ProductSearch.astro";
import ProductCategories from "./ProductCategories.astro";
---

<div class="product-toolbar space-y-6">
  <ProductSearch />
  <ProductCategories />
</div>

<script>
  const params = new URLSearchParams(window.location.search);
  const query = params.get("q")?.trim();
  if (query) {
    const input = document.querySelector<HTMLInputElement>(
      "#product-search [name='search']",
    );
    if (input) {
      input.value = query;
      document.dispatchEvent(new CustomEvent("product-filter:change"));
    }
  }
</script>

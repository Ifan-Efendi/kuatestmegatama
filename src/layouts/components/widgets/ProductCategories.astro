---
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";

interface Category {
  name: string;
  slug: string;
  count: number;
}

interface Props {
  class?: string;
}

const members = await getCollectionCTM("team", Astro.currentLocale);

let categories = (await getTaxonomy("team", "categories", Astro.currentLocale as string)) as Category[];

categories = categories.map((category) => {
  const count = members.filter((member) =>
    member.data.categories?.includes(category.name),
  ).length;

  return { ...category, count };
});

const t = await useTranslations(Astro.currentLocale as string);

categories = categories.sort((a, b) => {
  if (a.name === "Alat Laboratorium Umum") return 1;
  if (b.name === "Alat Laboratorium Umum") return -1;
  return b.count - a.count;
});
---

{
  categories && categories.length > 0 && (
    <div class="bg-theme-light rounded-2xl p-6 md:p-8" id="product-categories">
      <h2 class="text-h5-sm md:text-h5 mb-6">Kategori</h2>
      <div class="space-y-3">
        <button
          data-category=""
          class="text-primary hover:text-primary relative flex w-full items-center gap-4 text-base font-medium transition duration-300 cursor-pointer bg-transparent border-0 text-left">
          <span>Semua Produk</span>
          <div class="ms-auto text-sm">({members.length})</div>
        </button>
        {categories.map((category) => (
          <button
            data-category={category.name}
            class="hover:text-primary relative flex w-full items-center gap-4 text-base transition duration-300 cursor-pointer bg-transparent border-0 text-left">
            <span class="truncate" set:html={category.name} />
            <div class="ms-auto text-sm" set:html={`(${category.count})`} />
          </button>
        ))}
      </div>
    </div>
  )
}

<script>
  const filterContainer = document.getElementById("product-categories");
  filterContainer?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest("[data-category]") as HTMLElement;
    if (!btn) return;

    const category = btn.dataset.category || "";
    const cards = document.querySelectorAll<HTMLElement>(".product-team-card");

    filterContainer.querySelectorAll("[data-category]").forEach((b) => {
      b.classList.toggle("text-primary", b === btn);
      b.classList.toggle("font-medium", b === btn);
    });

    cards.forEach((card) => {
      if (!category) {
        card.classList.remove("hidden");
        return;
      }
      const cardCategories = (card.dataset.productCategories || "").split(",").map((c) => c.trim());
      card.classList.toggle("hidden", !cardCategories.includes(category));
    });
  });
</script>

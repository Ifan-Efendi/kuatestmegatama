---
import { getCollectionCTM } from "@/lib/contentParser.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";

interface Category {
  name: string;
  slug: string;
  count: number;
}

interface Props {
  class?: string;
}

const members = await getCollectionCTM("team", Astro.currentLocale);

let categories = (await getTaxonomy(
  "team",
  "categories",
  Astro.currentLocale as string,
)) as Category[];

categories = categories.map((category) => {
  const count = members.filter((member) =>
    member.data.categories?.includes(category.name),
  ).length;

  return { ...category, count };
});

categories = categories.sort((a, b) => {
  if (a.name === "Alat Laboratorium Umum") return 1;
  if (b.name === "Alat Laboratorium Umum") return -1;
  return b.count - a.count;
});
---

{
  categories && categories.length > 0 && (
    <div id="product-categories">
      <div class="flex flex-wrap gap-2">
        <button type="button" data-category="" class="cat-chip is-active">
          Semua Kategori
          <span class="cat-chip-count">{members.length}</span>
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-category={category.name}
              class="cat-chip">
              <span set:html={category.name} />
              <span class="cat-chip-count" set:html={String(category.count)} />
            </button>
          ))
        }
      </div>
    </div>
  )
}

<style>
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    border: 1px solid var(--color-border-light);
    border-radius: 9999px;
    background: var(--color-body);
    padding: 0.5rem 1rem;
    color: var(--color-text-default);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    box-shadow: 0 1px 2px rgb(7 8 0 / 0.06);
    transition: all 0.3s;
  }

  .cat-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .cat-chip.is-active,
  .cat-chip.is-active:hover {
    background: var(--color-theme-dark);
    border-color: var(--color-theme-dark);
    color: #ffffff;
  }

  .cat-chip-count {
    border-radius: 9999px;
    background: rgb(7 8 0 / 0.06);
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .cat-chip.is-active .cat-chip-count {
    background: rgb(255 255 255 / 0.18);
  }
</style>

<script>
  const filterContainer = document.getElementById("product-categories");

  filterContainer?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest(
      "[data-category]",
    ) as HTMLElement;
    if (!btn) return;

    filterContainer.querySelectorAll("[data-category]").forEach((b) => {
      b.classList.toggle("is-active", b === btn);
    });

    document.dispatchEvent(new CustomEvent("product-filter:change"));
  });
</script>

---
import Icons from "@/helpers/Icons.astro";
---

<div>
  <form id="product-search" class="relative">
    <Icons
      class="text-text-default pointer-events-none absolute top-1/2 start-4 size-5 -translate-y-1/2 opacity-50"
      icon="Search"
    />
    <input
      name="search"
      type="text"
      placeholder="Cari produk berdasarkan nama, kode, atau kategori..."
      class="form-input border-border-light w-full rounded-xl border! bg-white! p-3! ps-11! text-sm! transition placeholder:opacity-60! md:text-base! focus:border-primary!"
    />
  </form>
</div>

<script>
  const searchForm = document.getElementById("product-search");
  const searchInput = searchForm?.querySelector("[name='search']") as
    | HTMLInputElement
    | undefined;

  searchForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    document.dispatchEvent(new CustomEvent("product-filter:change"));
  });

  searchInput?.addEventListener("input", () => {
    document.dispatchEvent(new CustomEvent("product-filter:change"));
  });
</script>

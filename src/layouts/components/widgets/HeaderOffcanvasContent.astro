---
import config from ".astro/config.generated.json";
import Icons from "@/helpers/Icons.astro";
import Navbar from "../global/header/Navbar.astro";
import { useTranslations } from "@/lib/utils/i18nUtils.ts";

const {
  settings: {
    headerOffcanvas: { enable },
  },
} = config;

const t = await useTranslations(Astro.currentLocale as string);

const { offcanvas } = Astro.props;

if (!enable) {
  return null;
}
---

<div
  data-lenis-scroll-native
  class="offcanvas-navy bg-theme-dark flex h-screen flex-col overflow-auto px-6 pt-16 pb-8 md:px-10">
  <button
    type="button"
    data-hs-overlay={`#${offcanvas}`}
    title={t("aria.closeOffcanvas")}
    class="hover:bg-primary absolute end-6 top-5 z-20 inline-flex h-11 w-11 items-center justify-center gap-x-2 rounded-full bg-white/10 text-xl text-white ring-transparent transition-all duration-500 ease-out hover:rotate-90"
    aria-expanded="true">
    <Icons icon="X" />
  </button>

  <div class="lg:hidden">
    <Navbar isMobile={true} navigationButton={{ enable: false }} />
  </div>
</div>

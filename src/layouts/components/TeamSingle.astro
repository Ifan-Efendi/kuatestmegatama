---
import type { InferEntrySchema } from "astro:content";
import { markdownify } from "@/lib/utils/textConverter";
import { shortcodes } from "@/lib/shortcodes";
import OptimizedImage from "./utilities/OptimizedImage.astro";
import { render } from "astro:content";
import config from ".astro/config.generated.json";

const { data } = Astro.props.content;
const { title, image, profession } = data as InferEntrySchema<"team">;

const { Content } = await render(Astro.props.content);

// Product pages always show the company contact info, not per-entry placeholders.
const { phone, phone2, email } = config.settings.contactInfo as {
  phone: string;
  phone2?: string;
  email: string;
};
---

<section>
  <div class="container">
    <div
      class="team-single-layout mx-auto grid w-full grid-cols-1 items-center gap-y-10 lg:grid-cols-2">
      {
        image && (
          <div class="team-single-image relative overflow-hidden rounded-2xl">
            <OptimizedImage
              src={image}
              alt={title || "team member"}
              width={600}
              height={700}
              class="relative z-1 h-full w-full object-cover"
            />
          </div>
        )
      }

      <div class="team-single-content">
        <div class="space-y-2">
          {
            title && (
              <h1
                class="team-single-title md:text-h2 text-h3-sm"
                set:html={title}
              />
            )
          }
          {
            profession && (
              <p
                class="team-single-profession font-semibold"
                set:html={markdownify(profession)}
              />
            )
          }
        </div>

        <div class="team-single-bio prose-styles max-w-none">
          <Content components={shortcodes} />
        </div>

        <div class="team-single-contact space-y-3">
          {
            phone && (
              <div class="team-single-contact-item">
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.298-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.694.625 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                <span set:html={markdownify(phone)} />
              </div>
            )
          }

          {
            phone2 && (
              <div class="team-single-contact-item">
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.298-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.694.625 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
                </svg>
                <span set:html={markdownify(phone2)} />
              </div>
            )
          }

          {
            email && (
              <div class="team-single-contact-item">
                <svg
                  class="size-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true">
                  <path d="M3.5 5h17c.83 0 1.5.67 1.5 1.5v11c0 .83-.67 1.5-1.5 1.5h-17c-.83 0-1.5-.67-1.5-1.5v-11C2 5.67 2.67 5 3.5 5Zm.5 3.08v8.42c0 .28.22.5.5.5h15c.28 0 .5-.22.5-.5V8.08l-7.46 5.02c-.33.22-.76.22-1.09 0L4 8.08Zm.9-1.08 7.1 4.78L19.1 7H4.9Z" />
                </svg>
                <span set:html={markdownify(email)} />
              </div>
            )
          }
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .team-single-layout {
    max-width: 1272px;
    gap: 48px;
  }

  .team-single-image {
    min-height: 420px;
    background:
      radial-gradient(
        circle at 76% 18%,
        rgba(10, 102, 194, 0.16),
        transparent 30%
      ),
      radial-gradient(
        circle at 18% 82%,
        rgba(10, 102, 194, 0.1),
        transparent 28%
      ),
      linear-gradient(145deg, #f8fbfd 0%, #edf4f8 48%, #dfeaf1 100%);
  }

  .team-single-image::before {
    content: "";
    position: absolute;
    inset: 30px 30px 0;
    border-radius: 24px 24px 0 0;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: 0 18px 44px rgba(9, 30, 66, 0.1);
  }

  .team-single-content {
    color: #0a165e;
  }

  .team-single-title {
    color: #0a165e;
  }

  .team-single-profession {
    color: #2b4dff;
    font-size: 20px;
    line-height: 34px;
  }

  .team-single-bio {
    margin-top: 26px;
    color: #585b6f;
    font-size: 16px;
    line-height: 30px;
  }

  .team-single-contact {
    margin-top: 28px;
  }

  .team-single-contact-item {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #0a165e;
    font-size: 16px;
    line-height: 30px;
  }

  @media (min-width: 1024px) {
    .team-single-layout {
      grid-template-columns: minmax(420px, 526px) minmax(0, 626px);
      gap: 120px;
    }

    .team-single-image {
      min-height: 558px;
    }
  }
</style>

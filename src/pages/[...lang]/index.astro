---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import TeamSection from "@/components/sections/TeamSection.astro";
import BlogSection from "@/components/sections/BlogSection.astro";
import BannerThree from "@/components/sections/BannerThree.astro";
import MultipurposeSection from "@/components/sections/Section.astro";
import PartnerLogos from "@/components/sections/PartnerLogos.astro";
import WorkingProcessSection from "@/components/sections/WorkingProcessSection.astro";
import TestimonialQuoteSection from "@/components/sections/TestimonialQuoteSection.astro";
import ContactSectionTwo from "@/components/sections/ContactSectionTwo.astro";

export function getStaticPaths() {
  return generatePaths();
}

const homepageContent = await getEntryCTM(
  "homepage",
  "-index",
  Astro.currentLocale,
);

const skillSectionContent = await getEntryCTM(
  "sections",
  "startup-skill-section",
  Astro.currentLocale,
);
---

<Base {...homepageContent?.data} headerLayout="three" headerPosition="fixed">
  <BannerThree />
  <PartnerLogos
    title="Mitra & Perusahaan Kami"
    hasSectionBackground={true}
    hasSectionSpacing={true}
    logos={[
      { name: "WIKA Beton", image: "/images/partners/wika-beton.png" },
      { name: "Universitas Pelita Harapan", image: "/images/partners/uph.png" },
      { name: "Istaka Karya", image: "/images/partners/istaka-karya.png" },
      { name: "Waskita Karya", image: "/images/partners/waskita-karya.png" },
      { name: "Abipraya", image: "/images/partners/abipraya.png" },
      { name: "Bosowa", image: "/images/partners/bosowa.png" },
      { name: "Hutama Karya", image: "/images/partners/hk.png" },
      { name: "PP", image: "/images/partners/pp.png" },
      { name: "Universidade da Paz", image: "/images/partners/partner-2.png" },
      { name: "UNIB", image: "/images/partners/unib.png" },
      { name: "JKB", image: "/images/partners/jkb.png" },
      { name: "Nindya Karya", image: "/images/partners/nindya.png" },
      { name: "SCG", image: "/images/partners/scg.png" },
      { name: "Universitas Padang", image: "/images/partners/univ-padang.png" },
    ]}
  />
  <MultipurposeSection
    hasSectionBackground={true}
    hasSectionSpacing={false}
    content={skillSectionContent.data}
  />
  <WorkingProcessSection />
  <TestimonialQuoteSection />
  <ContactSectionTwo hasSectionSpacing={false} />
  <TeamSection hasDarkAppearance={true} hasSectionSpacing={false} />
  <BlogSection />
</Base>

---
import Base from "@/layouts/Base.astro";
import { generatePaths } from "@/lib/utils/i18nUtils.ts";
import PageHeader from "@/components/widgets/PageHeader.astro";
import GallerySection from "@/components/sections/GallerySection.astro";

export function getStaticPaths() {
  return generatePaths();
}
---

<Base
  title="Galeri"
  metaDescription="Galeri dokumentasi lapangan dan pengiriman PT. Kuatest Mega Tama"
  fitToScreen={false}>
  <PageHeader
    content={{
      title: "Galeri",
      segmentLabels: { gallery: "Galeri" },
    }}
  />
  <GallerySection />
</Base>
